# Copy values into the files below and fill in real values.
# Never commit .env or .env.local — both are gitignored.

# ---------------------------------------------------------------------------
# .env  (read by BOTH Next.js and the Prisma CLI in this repo)
# prisma.config.ts runs `import "dotenv/config"`, which loads ONLY `.env`,
# so DATABASE_URL must be here for commands like `npx prisma validate`.
#
# MongoDB connection string — use the format matching your instance:
#   MongoDB Atlas:   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/DBNAME?retryWrites=true&w=majority
#   Local MongoDB:   mongodb://127.0.0.1:27017/DBNAME
# Obtain the URI from your own Atlas project (Connect -> Drivers) or your
# local MongoDB setup. Do not commit real credentials.
DATABASE_URL="mongodb://127.0.0.1:27017/todo-dev"

# ---------------------------------------------------------------------------
# .env.local  (read by Next.js; where `npx clerk@latest env pull` writes)
# Clerk — obtain from https://dashboard.clerk.com (API keys page), or run:
#   npx clerk@latest env pull
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
