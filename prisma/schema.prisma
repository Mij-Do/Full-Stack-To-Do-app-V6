generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum TaskPriority {
  low
  medium
  high
}

enum TodoType {
  standalone
  withSubtasks
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
}

model Todo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  body String?
  completed Boolean @default(false)
  user_id String
  createdAt DateTime @default(now())
  dueDate DateTime?
  priority TaskPriority? @default(medium)
  todoType TodoType @default(standalone)
  subtasks  TodoSubtask[]
  recurrenceSeriesId String? @db.ObjectId
  recurrenceSeries TodoRecurrence? @relation(fields: [recurrenceSeriesId], references: [id])

  @@index([user_id, createdAt])
  @@index([recurrenceSeriesId])
}

model TodoRecurrence {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  user_id       String
  frequency     RecurrenceFrequency
  interval      Int
  active        Boolean            @default(true)
  currentTodoId String?            @db.ObjectId
  anchorDay     Int?
  createdAt     DateTime           @default(now())
  todos         Todo[]

  @@index([user_id, active])
}

model TodoSubtask {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  todoId    String   @db.ObjectId
  todo      Todo     @relation(fields: [todoId], references: [id])
  user_id   String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}
